# ============================================================================
# NEEDX — environment configuration
#
# Copy this file to .env in the repo root (docker-compose reads it from
# here) — or to apps/api/.env and apps/web/.env.local for running each app
# outside Docker. See ENVIRONMENT.md for what each variable actually does
# and which ones are safe to leave as-is for local development.
# ============================================================================

# ---- Core ----
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/needx

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Auth (REQUIRED — generate real random values, see ENVIRONMENT.md) ----
# openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_at_least_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# ---- Redis (provisioned, not yet required by any code path) ----
REDIS_URL=redis://localhost:6379

# ---- File storage ----
# STORAGE_DRIVER=local writes to apps/api/uploads/ and serves it statically.
# Switch to s3 + fill in the four values below to go to production.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# ---- Payments ----
# PAYMENT_PROVIDER=mock uses a real signed-webhook dev gateway — see
# apps/api/src/modules/payments/providers/mock-payment.provider.ts.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=dev_mock_webhook_secret_change_me

# ---- AI (optional — the app works fully without this, see ARCHITECTURE.md) ----
AI_PROVIDER=none
AI_API_KEY=

# ---- Email (optional — falls back to logging to the API console) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NEEDX <no-reply@needx.local>

# ---- SMS / OTP (optional — falls back to logging to the API console) ----
SMS_PROVIDER=console

# ---- Google OAuth (optional — /auth/google 501s until both are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- Web Push (optional but real — generate your own keypair) ----
# pnpm --filter @needx/api run vapid:generate
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@needx.local

# ---- Rate limiting ----
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
