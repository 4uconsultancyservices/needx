# ============================================================================
# NEEDX API — Vercel / Serverless Environment Configuration
# ============================================================================

NODE_ENV=production

# MongoDB Atlas connection string (REQUIRED — localhost won't work on Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/needx?retryWrites=true&w=majority

# CORS: URL of your deployed Next.js web app on Vercel
CORS_ORIGIN=https://needx-web.vercel.app
NEXT_PUBLIC_APP_URL=https://needx-web.vercel.app

# JWT Secrets (REQUIRED — generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string_at_least_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_TTL=7d
COOKIE_SECURE=true

# Storage: Use 'local' (ephemeral on serverless) or 's3' for persistent cloud storage
STORAGE_DRIVER=local

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace_with_random_secret
