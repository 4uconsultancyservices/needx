# ============================================================================
# NEEDX Web — Vercel / Frontend Environment Configuration
# ============================================================================

# Backend API URL (where the NestJS API is hosted, e.g. Railway, Render, Fly.io, or VPS)
# When deployed, requests to /api/v1/* are proxied via Next.js rewrites to this URL.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Public application URL (your Vercel production domain)
NEXT_PUBLIC_APP_URL=https://needx.yourdomain.com
